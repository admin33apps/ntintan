# ---------------------------------------------------------------
# Ntintan Groceries — environment configuration
# Copy to .env and fill in. Never commit the real .env file.
# ---------------------------------------------------------------

# development | production | test
NODE_ENV=production
# 1 = public demo/preview: simulated payments (PAYMENTS_MODE=simulate), sign-in codes on screen (SMS_MODE=log),
# a demo banner and no search-engine indexing. Leave empty for the real shop.
DEMO_MODE=

# Network
HOST=0.0.0.0
PORT=3000
# Your domain, without https:// (Docker/Caddy uses it to get the HTTPS certificate)
DOMAIN=ntintan.example.com
# Public URL customers use (used for payment callbacks and CORS/origin checks). Must be https://<DOMAIN>
PUBLIC_URL=https://ntintan.example.com
# Set to 1 when running behind a reverse proxy (Caddy / Nginx / load balancer)
TRUST_PROXY=1

# Storage (SQLite file). Put it on a persistent volume and back it up.
DATABASE_PATH=./data/ntintan.db
BACKUP_DIR=./data/backups

# Long random secret (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# First admin account (created on first start if no admin exists).
# ADMIN_PHONE receives the one-time code for 2-step admin sign-in.
# Remove these lines after the first start.
ADMIN_EMAIL=admin@ntintan.example.com
ADMIN_PASSWORD=
ADMIN_PHONE=0240000000

# ----------------- SMS & OTP sign-in (Sailup) ------------------
# sailup = real SMS through https://api.sailup.io/v1 (required in production)
# log    = print messages to the server log and return codes to the browser (development ONLY)
SMS_MODE=sailup
SAILUP_API_KEY=sailup_xxxxxxxxxxxxxxxx
# Sender ID registered and approved in your Sailup dashboard (3-11 characters)
SAILUP_SENDER_ID=NTINTAN
# Optional: delivery-status webhooks (Sailup dashboard -> Webhooks -> https://your-domain/api/sms/webhook)
SAILUP_WEBHOOK_SECRET=
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5

# ----------------- Payments (Paystack, GHS) --------------------
# paystack  = real payments (requires keys below)
# simulate  = local fake checkout for development/testing ONLY (refused in production)
# disabled  = only cash on delivery, Ogya wallet and coupons
PAYMENTS_MODE=paystack
# Secret key from Paystack → Settings → API Keys (starts with sk_live_ or sk_test_)
PAYSTACK_SECRET_KEY=
# Customers without an email are sent to Paystack as <phone>@<this domain>
CUSTOMER_EMAIL_DOMAIN=customers.ntintan.example.com

# ----------------- Business rules -------------------------------
# Money is stored in pesewas (1 GHS = 100 pesewas). 100 OGY = 1 GHS, so 1 OGY = 1 pesewa.
DELIVERY_FEE_PESEWAS=2500
FREE_DELIVERY_THRESHOLD_PESEWAS=30000
# Discount for paying with Ogya wallet, in basis points (500 = 5%)
OGYA_DISCOUNT_BPS=500
# Unpaid MoMo/card orders are cancelled (and stock released) after this many minutes
UNPAID_ORDER_TTL_MINUTES=60

# ----------------- Legal pages (/terms, /privacy) ---------------
# Shown on the Terms of Sale and Privacy Notice. Placeholders appear until set.
LEGAL_COMPANY_NAME=Ntintan Groceries Ltd
LEGAL_TRADING_NAME=Ntintan Groceries
LEGAL_REG_NUMBER=CS000000000
LEGAL_ADDRESS=Plot 0, Example Street, Accra (GA-000-0000), Ghana
LEGAL_SUPPORT_PHONE=0300000000
LEGAL_SUPPORT_EMAIL=support@ntintan.example.com
LEGAL_PRIVACY_EMAIL=privacy@ntintan.example.com
LEGAL_DPC_NUMBER=
LEGAL_HOSTING_LOCATION=
# Liquor licence (Liquor Licensing Act, 1970 (Act 331)) — required before selling alcohol
LEGAL_LIQUOR_LICENCE=
# Bump this (any string, e.g. a date) when you change the Terms; customers are asked to accept again.
TERMS_VERSION=2026-10-28.1
